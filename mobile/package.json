{
  "name": "phoenix-online-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "PHOENIX Online Android shell - private development build, not for publication.",
  "main": "index.html",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npx cap serve",
    "sync": "npx cap sync android",
    "open": "npx cap open android",
    "build:debug": "npx cap build android --keystore",
    "build:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/android": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "cordova-plugin-inappbrowser": "^7.0.0",
    "@capacitor/browser": "^8.0.5"
  }
}
